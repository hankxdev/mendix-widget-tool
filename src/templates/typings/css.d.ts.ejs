declare module "*.css" {
    const content: string;
    export default content;
}

declare module "*.scss" {
    const content: string;
    export default content;
}

declare module "*.sass" {
    const content: string;
    export default content;
}

declare module "*.svg" {
    const src: string;
    export default src;
}

declare module "*.json" {
    const value: unknown;
    export default value;
}
